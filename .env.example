# Copie para .env sem sobrescrever configuração existente. Nunca compartilhe chaves.
PORT=8787
# Provedor principal: escolha um modelo realmente disponível na sua conta.
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Alternativa opcional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OpenAI é opcional e começa desligada.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Pasta dedicada existente; vazio mantém ferramentas de arquivos bloqueadas.
JARVIS_FILES_ROOT=
# youtube ou spotify para reproduzir preferências salvas.
JARVIS_MUSIC_PROVIDER=youtube
# Spotify OAuth: token do fluxo oficial, conta compatível e dispositivo ativo.
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_DEVICE_ID=
